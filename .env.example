# Optional. Leave empty for unauthenticated access to public repositories.
# A fine-grained token with public repository read access is sufficient.
# GITHUB_TOKEN is required for search_code and recommended for higher rate limits.
GITHUB_TOKEN=

# Optional tuning values. Invalid or missing values use the documented defaults.
REPOLENS_TIMEOUT_MS=10000
REPOLENS_MAX_RESPONSE_BYTES=5242880
REPOLENS_MAX_FILE_BYTES=524288
REPOLENS_MAX_README_BYTES=65536
REPOLENS_MAX_TREE_ENTRIES=500
REPOLENS_MAX_PATCH_CHARS=4000
REPOLENS_MAX_CONCURRENCY=4
REPOLENS_MAX_RETRIES=2
REPOLENS_RETRY_DELAY_MS=250
REPOLENS_CACHE_TTL_MS=60000
REPOLENS_CACHE_MAX_ENTRIES=200
